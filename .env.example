# Copy to .env. Values are literal; no shell expansion. Never commit your .env.
LAUNCHLOOM_HOST=127.0.0.1
LAUNCHLOOM_PORT=8787
LAUNCHLOOM_DATA=.launchloom
# An access token is generated automatically when omitted (NOT an AI API key).
# LAUNCHLOOM_TOKEN=replace-with-at-least-24-random-characters

# Browser capture: only these exact origins can be visited. No inherited cookies.
CAPTURE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CHROMIUM_EXECUTABLE=/path/to/chromium
# Defaults to Chromium sandbox ON. Do not disable for untrusted sites.
CHROMIUM_NO_SANDBOX=0

# Optional creative direction. Base must include /v1 where required by provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional paid video. Choose the model and documented payload yourself.
FAL_KEY=
FAL_MODEL=
ENABLE_PAID_GENERATION=0
GENERATION_BUDGET_USD=0
# Budget = lifetime sum of operator estimates in this local DB, NOT actual billing.
# LLM calls, compute, storage and platform charges are not included.

# Optional self-hosted ComfyUI. Only operator-trusted API-format workflows.
COMFY_BASE_URL=

# Optional Postiz. Connect your social accounts in Postiz first.
POSTIZ_BASE_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=
ENABLE_LIVE_PUBLISH=0

# Pacing guards for approved posts on one channel in one campaign.
MAX_POSTS_PER_CHANNEL_PER_DAY=3
MIN_POST_GAP_MINUTES=30

# Optional landing-page deployment target: a directory you own and publish from.
# Nothing is written outside it, and a deploy still needs an explicit approval.
SITE_DEPLOY_DIR=

# Optional deployment. Do not expose the alpha publicly without isolation/TLS.
LAUNCHLOOM_PUBLIC_HOSTS=
SECURE_COOKIE=0
PUBLIC_TRACKING_BASE=

# Production execution is opt-in and independent from export/save.
# CI and a default local install leave paid generation, local agents and Adobe off.
# Dedicated Seedance 2.5 uses FAL_KEY + ENABLE_PAID_GENERATION above and this
# operator-maintained cost estimate. Re-check the provider price before paid use.
SEEDANCE_PRICE_PER_1K_TOKENS_USD=0.0214

# Optional local coding agents. Launchloom runs them in an isolated production
# folder and never enables them unless this flag is set.
ENABLE_LOCAL_AGENTS=0
# CODEX_EXECUTABLE=/path/to/codex
OPENAI_API_KEY=
# CLAUDE_EXECUTABLE=/path/to/claude
ANTHROPIC_API_KEY=
PRODUCTION_EXECUTION_TIMEOUT_SECONDS=600

# Optional Adobe execution. Windows can use afterfx.exe -r for reviewed JSX.
# macOS project creation remains manual (File > Scripts > Run Script File), while
# aerender can still automate a reviewed render once launchloom-project.aep exists.
ENABLE_AFTER_EFFECTS=0
# AFTERFX_EXECUTABLE=C:\\Program Files\\Adobe\\Adobe After Effects\\Support Files\\afterfx.exe
# AERENDER_EXECUTABLE=/Applications/Adobe After Effects 2026/aerender
